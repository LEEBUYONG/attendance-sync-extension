{
  "manifest_version": 3,
  "name": "Attendance Sync Helper",
  "version": "0.2.0",
  "description": "백오피스 출결 데이터를 자동 수집하여 Google Apps Script Web App으로 전송합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "출결 싱크"
  }
}
